# Copy to .env.local and fill in. Never commit real values.

# --- Firebase Admin (server) — choose ONE option ---
# On Firebase App Hosting none are needed: the backend's service account is used (see apphosting.yaml).
# Option 1: base64 of the service-account JSON (org policy blocks key creation for ad-radar-au)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Option 2: discrete fields (private key with literal \n escapes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option 3: leave all blank and use `gcloud auth application-default login` locally

# Named Firestore database
FIRESTORE_DATABASE_ID=ad-radar

# --- Firebase Web SDK (client, public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public origin for Stripe Checkout return links (e.g. https://app.example.com)
APP_URL=http://localhost:3000

# --- Phase 2: Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 3: SearchApi.io ---
SEARCHAPI_API_KEY=

# --- Phase 4: Gemini ---
GEMINI_API_KEY=
