rules_version = '2';

// Ad Radar — rules for the `ad-radar` Firestore database only (see firebase.json).
// Write authority: every write goes through the Firebase Admin SDK, which bypasses
// these rules. Clients get owner-scoped, read-only access. Anything not matched is denied.
//
// The Firebase project (so its Auth accounts and their custom claims) is shared with other apps, so no rule
// trusts a custom claim. Super Admin is the database admin's verified email; Main Admin is whoever Super
// Admin appointed, as recorded on users/{uid} in this database (which only the server writes).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // True when the caller's verified email is `email` (stored emails are lower-case).
    function hasVerifiedEmail(email) {
      return signedIn()
        && email is string && email.size() > 0
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == email;
    }

    // Keep this list the same as DATABASE_ADMIN_EMAILS in src/lib/firebase-admin.ts.
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in ['davidrobertson.info@gmail.com', 'support@aifoundation.net.au'];
    }

    // Appointed by Super Admin in Role Permissions; recorded on the caller's users/{uid} in this database.
    function isMainAdmin() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', [])
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isMainAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /brands/{brandId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Queries must filter on uid == request.auth.uid (or caller must be admin) or they are rejected.
    match /token_transactions/{txId} {
      allow read: if ownsDoc() || isAdmin();
      allow write: if false;
    }

    match /remixes/{remixId} {
      allow read: if ownsDoc();
      allow write: if false;
    }

    // Admin messages: sender user can read their own message, admin can read all.
    // Mutations are server-only via Firebase Admin SDK (plain text & 7-year retention enforcement).
    match /admin_messages/{messageId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.recipientUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Stripe purchase records: admin-only read for redistributive ledger tracking.
    // Mutations are server-only via Firebase Admin SDK webhook processing.
    match /stripe_purchases/{purchaseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Customization requests: requester or assigned Ad Agent can read, admin can read all.
    // Mutations are server-only via Firebase Admin SDK.
    match /customize_requests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || resource.data.assignedAgentUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Ad Agent records hold bank / PayID details: only the Ad Agent themself (by uid, or by verified email
    // when the record has no uid yet) and Super Admin may read them. Mutations are server-only.
    match /ad_agents/{agentId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid)
        || hasVerifiedEmail(resource.data.get('email', ''));
      allow write: if false;
    }

    // Contractor records hold the contractor's PayID details: only the Ad Agent who added them and Super
    // Admin may read them. Mutations are server-only via /api/contractors.
    match /ad_agent_contractors/{contractorId} {
      allow read: if isSuperAdmin()
        || (signedIn() && resource.data.get('agentUid', '') == request.auth.uid)
        || hasVerifiedEmail(resource.data.get('agentEmail', ''));
      allow write: if false;
    }

    // Global shared brands catalog: any signed-in user can read.
    // Mutations are server-only via Firebase Admin SDK.
    match /global_brands/{brandId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // normalized_ads/* and radar_cache/* are server-only: clients reach them through
    // the token-gated /api routes, so direct reads would bypass the ledger.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
