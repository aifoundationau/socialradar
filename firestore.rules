rules_version = '2';

// Ad Radar — rules for the `ad-radar` Firestore database only (see firebase.json).
// Write authority: every write goes through the Firebase Admin SDK, which bypasses
// these rules. Clients get owner-scoped, read-only access. Anything not matched is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsDoc() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /brands/{brandId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Queries must filter on uid == request.auth.uid or they are rejected.
    match /token_transactions/{txId} {
      allow read: if ownsDoc();
      allow write: if false;
    }

    match /remixes/{remixId} {
      allow read: if ownsDoc();
      allow write: if false;
    }

    // normalized_ads/* and radar_cache/* are server-only: clients reach them through
    // the token-gated /api routes, so direct reads would bypass the ledger.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
